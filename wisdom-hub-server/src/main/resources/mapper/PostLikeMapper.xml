<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wisdomhub.mapper.PostLikeMapper">

    <resultMap id="PostLikeResultMap" type="com.wisdomhub.entity.PostLike">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 点赞 -->
    <insert id="insert">
        INSERT INTO tb_post_like (post_id, user_id, create_time)
        VALUES (#{postId}, #{userId}, NOW())
    </insert>

    <!-- 取消点赞 -->
    <delete id="delete">
        DELETE FROM tb_post_like
        WHERE post_id = #{postId} AND user_id = #{userId}
    </delete>

    <!-- 查询是否已点赞 -->
    <select id="findByPostIdAndUserId" resultMap="PostLikeResultMap">
        SELECT * FROM tb_post_like
        WHERE post_id = #{postId} AND user_id = #{userId}
    </select>

    <!-- 统计点赞数 -->
    <select id="countByPostId" resultType="int">
        SELECT COUNT(*) FROM tb_post_like
        WHERE post_id = #{postId}
    </select>

</mapper>