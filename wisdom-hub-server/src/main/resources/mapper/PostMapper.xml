<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wisdomhub.mapper.PostMapper">

    <resultMap id="PostResultMap" type="com.wisdomhub.entity.Post">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="coverImage" column="cover_image"/>
        <result property="videoUrl" column="video_url"/>
        <result property="type" column="type"/>
        <result property="visibility" column="visibility"/>
        <result property="authorEmail" column="author_email"/>
        <result property="authorId" column="author_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 创建 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_post (
            title, content, cover_image, video_url, type, visibility, author_email, author_id, create_time, update_time
        ) VALUES (
                     #{title}, #{content}, #{coverImage}, #{videoUrl}, #{type}, #{visibility}, #{authorEmail}, #{authorId}, #{createTime}, #{updateTime}
                 )
    </insert>

    <!-- 根据ID查询 -->
    <select id="findById" resultMap="PostResultMap">
        SELECT * FROM tb_post WHERE id = #{id}
    </select>

    <!-- 我的花园 -->
    <select id="findGardenByAuthorEmail" resultMap="PostResultMap">
        SELECT * FROM tb_post
        WHERE author_email = #{authorEmail}
        <if test="includePrivate == false">
            AND visibility = 0
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 广场（仅公开） -->
    <select id="findPlaza" resultMap="PostResultMap">
        SELECT * FROM tb_post
        WHERE visibility = 0
        ORDER BY create_time DESC
    </select>

    <!-- 更新 -->
    <update id="update">
        UPDATE tb_post
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="videoUrl != null">video_url = #{videoUrl},</if>
            <if test="type != null">type = #{type},</if>
            <if test="visibility != null">visibility = #{visibility},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteById">
        DELETE FROM tb_post WHERE id = #{id}
    </delete>

</mapper>